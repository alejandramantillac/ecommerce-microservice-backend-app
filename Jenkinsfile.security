// Jenkinsfile for Scheduled Security Scans
pipeline {
    agent any

    environment {
        TARGET_ENVIRONMENT = 'security'
        SECURITY_REPORT_DIR = 'security-reports'
        SECURITY_IMAGE_LIST = "${SECURITY_REPORT_DIR}/image-list.txt"
        SECURITY_SUMMARY_CSV = "${SECURITY_REPORT_DIR}/summary.csv"
        SECURITY_SUMMARY_JSON = "${SECURITY_REPORT_DIR}/summary.json"
        SECURITY_DASHBOARD = "${SECURITY_REPORT_DIR}/security-dashboard.html"
    }

    triggers {
        cron('H H * * *') // Daily scan
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Initialize') {
            steps {
                deleteDir()
                checkout scm
                script {
                    def commonVars = load 'jenkins/shared-lib/vars/commonVars.groovy'
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'

                    env.REGISTRY = commonVars.getRegistry()
                    env.SCAN_SEVERITY = commonVars.getTrivySeverityThreshold()
                    env.CHANGED_SERVICES = 'security-scan'
                    env.K8S_NAMESPACE = commonVars.getNamespaces().staging

                    sh "mkdir -p ${env.SECURITY_REPORT_DIR}"
                    commonFunctions.initializePipelineVariables()
                }
            }
        }

        stage('Fetch Images') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                        string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                        string(credentialsId: 'ARM_SUBSCRIPTION_ID', variable: 'ARM_SUBSCRIPTION_ID'),
                        string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                    ]) {
                        sh """
                            set -e
                            mkdir -p \${WORKSPACE}/.kube
                            cd infra/terraform/environments/${env.K8S_NAMESPACE}
                            terraform init -input=false -backend=false >/dev/null
                            RG_NAME=\$(terraform output -raw resource_group_name)
                            AKS_NAME=\$(terraform output -raw aks_cluster_name)
                            az login --service-principal -u "\$ARM_CLIENT_ID" -p "\$ARM_CLIENT_SECRET" --tenant "\$ARM_TENANT_ID" >/dev/null
                            az aks get-credentials --resource-group "\$RG_NAME" --name "\$AKS_NAME" --file "\${WORKSPACE}/.kube/security-${env.K8S_NAMESPACE}" --overwrite-existing
                        """
                    }

                    env.SECURITY_KUBECONFIG = "${env.WORKSPACE}/.kube/security-${env.K8S_NAMESPACE}"

                    sh """
                        set -e
                        mkdir -p ${env.SECURITY_REPORT_DIR}
                        kubectl --kubeconfig="${env.SECURITY_KUBECONFIG}" get pods -n "\${env.K8S_NAMESPACE}" -o jsonpath='{..image}' \
                            | tr ' ' '\\n' | sort -u | grep -v '^$' > "\${env.SECURITY_IMAGE_LIST}"

                        if [ ! -s "\${env.SECURITY_IMAGE_LIST}" ]; then
                            echo "No images found in \${env.K8S_NAMESPACE} namespace." >&2
                            exit 1
                        fi
                    """
                }
            }
        }

        stage('Scan Images with Trivy') {
            steps {
                script {
                    sh """
                        chmod +x jenkins/scripts/security-scan-images.sh
                        jenkins/scripts/security-scan-images.sh \\
                            "${env.SECURITY_IMAGE_LIST}" \\
                            "${env.SECURITY_REPORT_DIR}" \\
                            "${env.SECURITY_SUMMARY_CSV}" \\
                            "${env.SECURITY_SUMMARY_JSON}" \\
                            "${env.SCAN_SEVERITY}"
                    """
                }
            }
        }

        stage('Generate Security Dashboard') {
            steps {
                sh """
                    python3 jenkins/scripts/security-generate-dashboard.py \\
                        "${env.SECURITY_SUMMARY_JSON}" \\
                        "${env.SECURITY_DASHBOARD}"
                """
            }
        }

        stage('Publish Security Reports') {
            steps {
                publishHTML([
                    allowMissing: false,
                    reportDir: "${env.SECURITY_REPORT_DIR}",
                    reportFiles: 'security-dashboard.html',
                    reportName: 'Security Vulnerability Dashboard',
                    keepAll: true,
                    alwaysLinkToLastBuild: true
                ])

                archiveArtifacts artifacts: "${env.SECURITY_REPORT_DIR}/**/*",
                                   fingerprint: true,
                                   allowEmptyArchive: false
            }
        }

        stage('Evaluate Findings & Set Result') {
            steps {
                script {
                    def summary = readJSON file: env.SECURITY_SUMMARY_JSON
                    def totals = summary.totals ?: [:]
                    def services = summary.services ?: [:]

                    def impacted = services.findAll { k, v ->
                        (v.critical ?: 0) > 0 || (v.high ?: 0) > 0 || (v.medium ?: 0) > 0 || (v.low ?: 0) > 0
                    }.collect { it.key }

                    env.CHANGED_SERVICES = impacted ? impacted.join(',') : 'security-scan'

                    if ((totals.critical ?: 0) > 0) {
                        currentBuild.result = 'FAILURE'
                    } else if ((totals.high ?: 0) > 0 || (totals.medium ?: 0) > 0) {
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifySuccess(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
            cleanWs()
        }
        unstable {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifyWarning(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
            cleanWs()
        }
        failure {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifyFailure(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
            cleanWs()
        }
    }
}

