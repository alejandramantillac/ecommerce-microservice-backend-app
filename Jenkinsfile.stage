// Jenkinsfile for Staging Environment
// Purpose: Complete validation - Build, Deploy, and All Tests

pipeline {
    agent any
    
    environment {
        TARGET_ENVIRONMENT = 'staging'
        TF_STAGING_APPLIED = 'false'
    }
    
    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    
    stages {
        stage('Initialize') {
            steps {
                deleteDir()
                checkout scm
                script {
                    // Load shared library functions
                    def commonVars = load 'jenkins/shared-lib/vars/commonVars.groovy'
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    
                    // Set environment variables from commonVars
                    env.REGISTRY = commonVars.getRegistry()
                    env.DOCKERHUB = commonVars.getDockerHubCredential()
                    commonFunctions.initializePipelineVariables()
                    
                    def namespaces = commonVars.getNamespaces()
                    
                    env.K8S_NAMESPACE = namespaces.staging
                    env.IMAGE_TAG = commonFunctions.generateImageTag(env.GIT_BRANCH, env.GIT_COMMIT_SHORT, 'staging')
                    env.LATEST_TAG = "latest-staging"
                    env.SONAR_HOST_URL = commonVars.getSonarHostUrl()
                    env.SONAR_ORGANIZATION = commonVars.getSonarOrganization()
                    env.SONAR_ENFORCE_QUALITY_GATE = commonVars.getSonarEnforceQualityGate()
                    env.TRIVY_SEVERITY_THRESHOLD = commonVars.getTrivySeverityThreshold()
                    env.TRIVY_EXIT_ON_FAILURE = commonVars.getTrivyExitOnFailure()
                    env.TRIVY_REPORT_FORMAT = commonVars.getTrivyReportFormat()
                    
                    commonFunctions.printDeploymentInfo(env.TARGET_ENVIRONMENT, env.IMAGE_TAG, env.K8S_NAMESPACE)
                    
                    def services = commonVars.getServicesList()
                    env.CHANGED_SERVICES = commonFunctions.detectChangedServices(services)
                }
                stash name: 'workspace', includes: '**/*'
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    def commonVars = load 'jenkins/shared-lib/vars/commonVars.groovy'
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    
                    echo "Building changed services: ${env.CHANGED_SERVICES}"
                    commonFunctions.buildServicesInParallel(
                        env.CHANGED_SERVICES, 
                        env.REGISTRY, 
                        env.IMAGE_TAG, 
                        env.LATEST_TAG
                    )
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    commonFunctions.runTrivyScans(env.CHANGED_SERVICES, env.REGISTRY, env.IMAGE_TAG)
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        commonFunctions.runSonarAnalyses(env.CHANGED_SERVICES)
                    }
                }
            }
        }
        
        stage('Publish Results') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    commonFunctions.publishAllTestResults(env.CHANGED_SERVICES)
                }
            }
        }

        stage('Publish to Registry') {
            steps {
                unstash 'workspace'
                withCredentials([usernamePassword(
                    credentialsId: "${DOCKERHUB}", 
                    usernameVariable: 'DOCKER_USER', 
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        commonFunctions.pushDockerImages(
                            env.REGISTRY,
                            env.IMAGE_TAG,
                            env.LATEST_TAG,
                            env.CHANGED_SERVICES,
                            env.DOCKER_USER,
                            env.DOCKER_PASS
                        )
                    }
                }
            }
        }

        stage('Provision Infrastructure (Terraform)') {
            steps {
                script {
                    echo "Provisioning staging infrastructure via Terraform..."
                    withCredentials([
                        string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                        string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                        string(credentialsId: 'ARM_SUBSCRIPTION_ID', variable: 'ARM_SUBSCRIPTION_ID'),
                        string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                    ]) {
                        sh '''
                            set -e
                            cd infra/terraform/environments/staging
                            terraform version
                            terraform init -input=false
                            terraform apply -input=false -auto-approve -var-file=staging.tfvars
                            RG_NAME=$(terraform output -raw resource_group_name)
                            AKS_NAME=$(terraform output -raw aks_cluster_name)
                            mkdir -p "${WORKSPACE}/.kube"
                            rm -f "${WORKSPACE}/.kube/${TARGET_ENVIRONMENT}-config"
                            az login --service-principal -u "$ARM_CLIENT_ID" -p "$ARM_CLIENT_SECRET" --tenant "$ARM_TENANT_ID" >/dev/null
                            az aks get-credentials --resource-group "$RG_NAME" --name "$AKS_NAME" --file "${WORKSPACE}/.kube/${TARGET_ENVIRONMENT}-config" --overwrite-existing
                        '''
                    }
                    env.KUBE_CONFIG_PATH = "${env.WORKSPACE}/.kube/${env.TARGET_ENVIRONMENT}-config"
                    env.TF_STAGING_APPLIED = 'true'
                    stash name: 'kubeconfig', includes: ".kube/${env.TARGET_ENVIRONMENT}-config"
                }
            }
        }

        stage('Deploy Monitoring Stack') {
            steps {
                unstash 'workspace'
                unstash 'kubeconfig'
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "Deploying monitoring stack (Prometheus, Grafana, Alertmanager)..."
                        commonFunctions.deployMonitoringStack(
                            env.K8S_NAMESPACE,
                            env.TARGET_ENVIRONMENT,
                            'NodePort'  // Use NodePort for staging
                        )
                    }
                }
            }
        }

        stage('Deploy ELK Stack') {
            steps {
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "Deploying ELK stack (Elasticsearch, Logstash, Kibana, Filebeat)..."
                        commonFunctions.deployELKStack(
                            env.K8S_NAMESPACE,
                            env.TARGET_ENVIRONMENT,
                            'NodePort'  // Use NodePort for staging
                        )
                    }
                }
            }
        }
        
        stage('Deploy to Staging') {
            steps {
                unstash 'workspace'
                unstash 'kubeconfig'
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "Deploying to staging environment..."
                        commonFunctions.deployToKubernetes(
                            env.TARGET_ENVIRONMENT,
                            env.K8S_NAMESPACE,
                            env.REGISTRY,
                            env.IMAGE_TAG,
                            env.CHANGED_SERVICES
                        )
                    }
                }
            }
        }

        stage('Run Tests') {
            steps {
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "Running all test suites..."
                        env.API_GATEWAY_URL = commonFunctions.getLoadBalancerIP('api-gateway', 'staging')

                        echo "API Gateway URL: ${env.API_GATEWAY_URL}"

                        commonFunctions.runAllTests(env.K8S_NAMESPACE)
                    }
                }
            }
        }
    }
    
    post {
        success {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifySuccess(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
                echo "All tests passed - ready for production!"
            }
        }
        failure {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                def servicesToRollback = env.SUCCESSFUL_DEPLOYS
                if (servicesToRollback?.trim()) {
                    commonFunctions.rollbackServices(env.K8S_NAMESPACE, servicesToRollback, env.KUBE_CONFIG_PATH)
                } else {
                    echo "Skipping rollback: staging deployment did not run in this execution."
                }
                commonFunctions.notifyFailure(env.TARGET_ENVIRONMENT, servicesToRollback)
                echo "Consider rolling back staging deployment"
            }
        }
        always {
            script {
                if (env.TF_STAGING_APPLIED == 'true') {
                    echo "Destroying staging infrastructure via Terraform..."
                    try {
                        withCredentials([
                            string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                            string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                            string(credentialsId: 'ARM_SUBSCRIPTION_ID', variable: 'ARM_SUBSCRIPTION_ID'),
                            string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                        ]) {
                            sh '''
                                set +e
                                cd infra/terraform/environments/staging
                                terraform destroy -input=false -auto-approve -var-file=staging.tfvars
                            '''
                        }
                    } catch (err) {
                        echo "Terraform destroy failed: ${err}"
                    }
                } else {
                    echo "Skipping Terraform destroy (infrastructure was not provisioned by this run)."
                }
            }
        }
        cleanup {
            cleanWs()
        }
    }
}