// Jenkinsfile for Scheduled Security Scans
pipeline {
    agent any

    environment {
        TARGET_ENVIRONMENT = 'security'
        SECURITY_REPORT_DIR = 'security-reports'
        SECURITY_IMAGE_LIST = "${SECURITY_REPORT_DIR}/images.txt"
        SECURITY_SUMMARY_CSV = "${SECURITY_REPORT_DIR}/summary.csv"
        SECURITY_SUMMARY_JSON = "${SECURITY_REPORT_DIR}/summary.json"
        SECURITY_DASHBOARD = "${SECURITY_REPORT_DIR}/security-dashboard.html"
    }

    triggers {
        cron('H H * * *') // Daily scan
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Initialize') {
            steps {
                deleteDir()
                checkout scm
                script {
                    def commonVars = load 'jenkins/shared-lib/vars/commonVars.groovy'
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'

                    env.REGISTRY = commonVars.getRegistry()
                    env.SCAN_SEVERITY = "CRITICAL,HIGH,MEDIUM,LOW"
                    env.CHANGED_SERVICES = 'security-scan'
                    env.K8S_NAMESPACE = commonVars.getNamespaces().staging

                    sh "mkdir -p ${env.SECURITY_REPORT_DIR}"
                    commonFunctions.initializePipelineVariables()
                }
            }
        }

        stage('Fetch Images') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    env.SECURITY_KUBECONFIG = commonFunctions.getAndConfigureKubeConfigFromTerraform(env.K8S_NAMESPACE, env.ARM_CLIENT_ID, env.ARM_CLIENT_SECRET, env.ARM_TENANT_ID)
                    env.SECURITY_IMAGE_LIST = commonFunctions.collectPodImages(env.K8S_NAMESPACE, env.SECURITY_KUBECONFIG, env.SECURITY_REPORT_DIR)
                }
            }
        }

        stage('Scan Images with Trivy') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    commonFunctions.scanImagesWithTrivy(env.SECURITY_IMAGE_LIST, env.SECURITY_REPORT_DIR, env.SECURITY_SUMMARY_CSV, env.SECURITY_SUMMARY_JSON, env.SCAN_SEVERITY)
                }
            }
        }

        stage('Generate Security Dashboard') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    commonFunctions.generateSecurityDashboard(env.SECURITY_SUMMARY_JSON, env.SECURITY_DASHBOARD)
                }
            }
        }

        stage('Publish Security Reports') {
            steps {
                script {
                    archiveArtifacts artifacts: "${env.SECURITY_REPORT_DIR}/**/*", fingerprint: true, allowEmptyArchive: false
                    if (env.BUILD_URL) {
                        def dashboardUrl = "${env.BUILD_URL}artifact/${env.SECURITY_DASHBOARD}"
                        echo "Security dashboard available at: ${dashboardUrl}"
                    }
                }
            }
        }

        stage('Evaluate Findings & Set Result') {
            steps {
                script {
                    def summary = readJSON file: env.SECURITY_SUMMARY_JSON
                    def totals = summary.totals ?: [:]
                    def services = summary.services ?: [:]

                    def impacted = services.findAll { k, v ->
                        (v.critical ?: 0) > 0 || (v.high ?: 0) > 0 || (v.medium ?: 0) > 0 || (v.low ?: 0) > 0
                    }.collect { it.key }

                    env.CHANGED_SERVICES = impacted ? impacted.join(',') : 'security-scan'

                    if ((totals.critical ?: 0) > 0) {
                        currentBuild.result = 'FAILURE'
                    } else if ((totals.high ?: 0) > 0 || (totals.medium ?: 0) > 0) {
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifySuccess(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
            cleanWs()
        }
        unstable {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifyWarning(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
            cleanWs()
        }
        failure {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifyFailure(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
            cleanWs()
        }
    }
}
