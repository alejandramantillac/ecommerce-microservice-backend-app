// Jenkinsfile for Production Environment
// Purpose: Full release pipeline - Validate in staging, approve, deploy to prod, generate release

pipeline {
    agent any
    
    environment {
        TARGET_ENVIRONMENT = 'production'
        BASE_RELEASE_VERSION = '0.0.0'  // Base version for semantic versioning
        TF_PROD_APPLIED = 'false'
    }
    
    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }
    
    stages {
        stage('Initialize') {
            steps {
                deleteDir()
                checkout scm
                script {
                    // Load shared library functions
                    def commonVars = load 'jenkins/shared-lib/vars/commonVars.groovy'
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    
                    // Set environment variables from commonVars
                    env.REGISTRY = commonVars.getRegistry()
                    env.DOCKERHUB = commonVars.getDockerHubCredential()
                    env.KUBECONFIG_CREDENTIAL = commonVars.getKubeConfigCredential()
                    env.GITHUB_TOKEN_CREDENTIAL = commonVars.getGitHubTokenCredential()
                    
                    commonFunctions.initializePipelineVariables()
                    
                    def namespaces = commonVars.getNamespaces()
                    
                    env.K8S_NAMESPACE_STAGING = namespaces.staging
                    env.K8S_NAMESPACE_PROD = namespaces.prod
                    env.IMAGE_TAG = commonFunctions.generateImageTag(env.GIT_BRANCH, env.GIT_COMMIT_SHORT)
                    env.LATEST_TAG = "latest"
                    env.SONAR_HOST_URL = commonVars.getSonarHostUrl()
                    env.SONAR_ORGANIZATION = commonVars.getSonarOrganization()
                    env.SONAR_ENFORCE_QUALITY_GATE = commonVars.getSonarEnforceQualityGate()
                    env.TRIVY_SEVERITY_THRESHOLD = commonVars.getTrivySeverityThreshold()
                    env.TRIVY_EXIT_ON_FAILURE = commonVars.getTrivyExitOnFailure()
                    env.TRIVY_REPORT_FORMAT = commonVars.getTrivyReportFormat()
                    
                    // Calculate semantic version automatically based on commits
                    echo "Calculating semantic version from commits..."
                    def versionOutput = sh(
                        script: """
                            chmod +x jenkins/scripts/calculate-semantic-version.sh
                            jenkins/scripts/calculate-semantic-version.sh "${env.BASE_RELEASE_VERSION}"
                        """,
                        returnStdout: true
                    ).trim()
                    def versionLines = versionOutput.readLines()
                    env.RELEASE_VERSION = versionLines ? versionLines.last().trim() : env.BASE_RELEASE_VERSION
                    
                    echo "========================================="
                    echo "Production Release Pipeline"
                    echo "========================================="
                    echo "Release Version: ${env.RELEASE_VERSION}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                    echo "Staging Namespace: ${env.K8S_NAMESPACE_STAGING}"
                    echo "Production Namespace: ${env.K8S_NAMESPACE_PROD}"
                    echo "========================================="
                    
                    def services = commonVars.getServicesList()
                    env.CHANGED_SERVICES = commonFunctions.detectChangedServices(services)
                }
                stash name: 'workspace', includes: '**/*'
            }
        }

        stage('Provision Production Infrastructure (Terraform)') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    commonFunctions.provisionInfrastructureWithTerraform(
                        'prod',
                        env.ARM_CLIENT_ID,
                        env.ARM_CLIENT_SECRET,
                        env.ARM_SUBSCRIPTION_ID,
                        env.ARM_TENANT_ID
                    )
                    env.PROD_KUBE_CONFIG_PATH = "${env.WORKSPACE}/.kube/prod-config"
                    env.TF_PROD_APPLIED = 'true'
                }
            }
        }
        
        stage('Get Monitoring Endpoints (Production)') {
            steps {
                unstash 'workspace'
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    echo "Retrieving monitoring endpoints from Terraform outputs..."
                    
                    // Verify and fix DCR stream configuration before getting endpoints
                    commonFunctions.verifyAndFixDcrStream(env.K8S_NAMESPACE_PROD)
                    
                    def monitoringOutputs = commonFunctions.getMonitoringOutputs(env.K8S_NAMESPACE_PROD)
                    def outputFile = commonFunctions.saveMonitoringOutputs(env.K8S_NAMESPACE_PROD, monitoringOutputs)
                    stash name: 'prod-monitoring-outputs', includes: ".monitoring-${env.K8S_NAMESPACE_PROD}.env"
                    env.PROMETHEUS_INGESTION_ENDPOINT = monitoringOutputs.prometheusIngestionEndpoint
                    env.PROMETHEUS_QUERY_ENDPOINT = monitoringOutputs.prometheusQueryEndpoint
                    env.GRAFANA_ENDPOINT = monitoringOutputs.grafanaEndpoint
                }
            }
        }

        stage('Assign DCR Permissions (Production)') {
            steps {
                unstash 'workspace'
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    echo "Assigning Monitoring Metrics Publisher role to Service Principal on DCR..."
                    withCredentials([
                        string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID')
                    ]) {
                        commonFunctions.assignDcrPermissions(env.K8S_NAMESPACE_PROD, env.ARM_CLIENT_ID)
                    }
                }
            }
        }

        stage('Deploy Prometheus Agent (Production)') {
            steps {
                unstash 'workspace'
                unstash 'prod-kubeconfig'
                unstash 'prod-monitoring-outputs'
                withEnv(["KCFG=${env.PROD_KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        def monitoringOutputs = commonFunctions.loadMonitoringOutputs(env.K8S_NAMESPACE_PROD)
                        withCredentials([
                            string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                            string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                            string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                        ]) {
                            echo "Deploying Prometheus Agent to production..."
                            commonFunctions.deployPrometheusAgent(
                                env.K8S_NAMESPACE_PROD,
                                env.TARGET_ENVIRONMENT,
                                monitoringOutputs.prometheusIngestionEndpoint,
                                env.ARM_CLIENT_ID,
                                env.ARM_TENANT_ID,
                                env.ARM_CLIENT_SECRET
                            )
                        }
                    }
                }
            }
        }
        
        stage('Migrate Grafana Dashboards (Production)') {
            steps {
                unstash 'workspace'
                unstash 'prod-monitoring-outputs'
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    def monitoringOutputs = commonFunctions.loadMonitoringOutputs(env.K8S_NAMESPACE_PROD)
                    
                    // Obtener token de Grafana (espera automáticamente si no existe)
                    def grafanaApiKey = commonFunctions.getGrafanaApiKey(env.K8S_NAMESPACE_PROD, monitoringOutputs.grafanaName)
                    
                    // Migrar dashboards
                    commonFunctions.migrateGrafanaDashboards(
                        monitoringOutputs.grafanaEndpoint,
                        grafanaApiKey,
                        monitoringOutputs.prometheusQueryEndpoint,
                        'k8s/monitoring/grafana-dashboards',
                        env.TARGET_ENVIRONMENT
                    )
                }
            }
        }

        stage('Get Logging Endpoints (Production)') {
            steps {
                unstash 'workspace'
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    echo "Retrieving logging endpoints from Terraform outputs..."
                    def loggingOutputs = commonFunctions.getLoggingOutputs(env.K8S_NAMESPACE_PROD)
                    def outputFile = commonFunctions.saveLoggingOutputs(env.K8S_NAMESPACE_PROD, loggingOutputs)
                    stash name: 'prod-logging-outputs', includes: ".logging-${env.K8S_NAMESPACE_PROD}.env"
                    env.ELASTICSEARCH_ENDPOINT = loggingOutputs.elasticsearchEndpoint
                    env.ELASTICSEARCH_INTERNAL_ENDPOINT = loggingOutputs.elasticsearchInternalEndpoint
                    env.KIBANA_ENDPOINT = loggingOutputs.kibanaEndpoint
                    env.LOGSTASH_ENDPOINT = loggingOutputs.logstashEndpoint
                }
            }
        }

        stage('Deploy Filebeat (Production)') {
            steps {
                unstash 'workspace'
                unstash 'prod-kubeconfig'
                unstash 'prod-logging-outputs'
                withEnv(["KCFG=${env.PROD_KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        def loggingOutputs = commonFunctions.loadLoggingOutputs(env.K8S_NAMESPACE_PROD)
                        echo "Deploying Filebeat to send logs to Elasticsearch..."
                        echo "Elasticsearch Endpoint: ${loggingOutputs.elasticsearchEndpoint}"
                        commonFunctions.deployFilebeat(
                            env.K8S_NAMESPACE_PROD,
                            env.TARGET_ENVIRONMENT,
                            loggingOutputs.logAnalyticsWorkspaceId,
                            loggingOutputs.logAnalyticsCustomerId,
                            loggingOutputs.logAnalyticsSharedKey
                        )
                    }
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                unstash 'workspace'
                unstash 'prod-kubeconfig'
                withEnv(["KCFG=${env.PROD_KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "========================================="
                        echo "🚀 Deploying Release ${env.RELEASE_VERSION} to PRODUCTION"
                        echo "========================================="
                        
                        commonFunctions.deployToKubernetes(
                            'prod',
                            env.K8S_NAMESPACE_PROD,
                            env.REGISTRY,
                            env.IMAGE_TAG,
                            env.CHANGED_SERVICES
                        )
                        
                        env.PROD_DEPLOYS = env.SUCCESSFUL_DEPLOYS
                        echo "✓ Production deployment completed"
                    }
                }
            }
        }

        stage('Generate Release Notes') {
            steps {
                withCredentials([
                    string(credentialsId: "${GITHUB_TOKEN_CREDENTIAL}", variable: 'GITHUB_TOKEN')
                ]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "Generating release notes and creating Git tag..."
                        commonFunctions.generateAndPublishRelease(
                            env.RELEASE_VERSION,
                            env.GITHUB_TOKEN
                        )
                        
                        echo "✓ Release notes generated"
                        echo "✓ Git tag v${env.RELEASE_VERSION} created"
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'release_notes.md,CHANGELOG.md', 
                                     fingerprint: true, 
                                     allowEmptyArchive: true
                }
            }
        }
    }
    
    post {
        success {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                echo "========================================="
                echo "✅ PRODUCTION RELEASE SUCCESSFUL!"
                echo "========================================="
                echo "Release Version: v${env.RELEASE_VERSION}"
                echo "Services Deployed: ${env.CHANGED_SERVICES}"
                echo "Image Tag: ${env.IMAGE_TAG}"
                echo "Namespace: ${env.K8S_NAMESPACE_PROD}"
                echo "Git Tag: v${env.RELEASE_VERSION}"
                echo "========================================="
                echo "📝 Release notes and artifacts have been archived"
                echo "🏷️  Git tag has been created"
                echo "🎉 Production is live with the new release!"
                echo "========================================="
                
                commonFunctions.notifySuccess(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
        }
        failure {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                echo "========================================="
                echo "❌ PRODUCTION RELEASE FAILED!"
                echo "========================================="
                echo "Release Version: v${env.RELEASE_VERSION}"
                echo "Failed Stage: ${env.STAGE_NAME}"
                echo "========================================="
                echo "⚠️  IMMEDIATE ACTION REQUIRED"
                echo "📋 Review logs and test reports"
                echo "🔄 Consider rollback procedures if deployment reached production"
                echo "========================================="
                
                def prodServices = env.PROD_DEPLOYS
                def stagingServices = env.STAGING_DEPLOYS

                if (prodServices?.trim()) {
                    commonFunctions.rollbackServices(env.K8S_NAMESPACE_PROD, prodServices, env.PROD_KUBE_CONFIG_PATH)
                } else {
                    echo "Skipping rollback at production: no deployment occurred in this run."
                }
                
                if (stagingServices?.trim()) {
                    commonFunctions.rollbackServices(env.K8S_NAMESPACE_STAGING, stagingServices, env.STAGING_KUBE_CONFIG_PATH)
                } else {
                    echo "Skipping rollback at staging: no deployment occurred in this run."
                }

                commonFunctions.notifyFailure(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
            }
        }
        unstable {
            script {
                echo "========================================="
                echo "⚠️  Pipeline completed with warnings"
                echo "Review test results before production use"
                echo "========================================="
            }
        }
        always {
            script {
                if (env.TF_PROD_APPLIED == 'true') {
                    echo "Destroying production infrastructure via Terraform..."
                    try {
                        withCredentials([
                            string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                            string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                            string(credentialsId: 'ARM_SUBSCRIPTION_ID', variable: 'ARM_SUBSCRIPTION_ID'),
                            string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                        ]) {
                            sh '''
                                set +e
                                cd infra/terraform/environments/prod
                                terraform destroy -input=false -auto-approve -var-file=prod.tfvars
                            '''
                        }
                    } catch (err) {
                        echo "Terraform destroy failed: ${err}"
                    }
                } else {
                    echo "Skipping Terraform destroy (infrastructure was not provisioned by this run)."
                }
            }
        }
        cleanup {
            cleanWs()
        }
    }
}