// Jenkinsfile for Staging Environment
// Purpose: Complete validation - Build, Deploy, and All Tests

pipeline {
    agent any
    
    environment {
        TARGET_ENVIRONMENT = 'staging'
        TF_STAGING_APPLIED = 'false'
    }
    
    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    
    stages {
        stage('Initialize') {
            steps {
                deleteDir()
                checkout scm
                script {
                    // Load shared library functions
                    def commonVars = load 'jenkins/shared-lib/vars/commonVars.groovy'
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    
                    // Set environment variables from commonVars
                    env.REGISTRY = commonVars.getRegistry()
                    env.DOCKERHUB = commonVars.getDockerHubCredential()
                    commonFunctions.initializePipelineVariables()
                    
                    def namespaces = commonVars.getNamespaces()
                    
                    env.K8S_NAMESPACE = namespaces.staging
                    env.IMAGE_TAG = commonFunctions.generateImageTag(env.GIT_BRANCH, env.GIT_COMMIT_SHORT, 'staging')
                    env.LATEST_TAG = "latest-staging"
                    env.SONAR_HOST_URL = commonVars.getSonarHostUrl()
                    env.SONAR_ORGANIZATION = commonVars.getSonarOrganization()
                    env.SONAR_ENFORCE_QUALITY_GATE = commonVars.getSonarEnforceQualityGate()
                    env.TRIVY_SEVERITY_THRESHOLD = commonVars.getTrivySeverityThreshold()
                    env.TRIVY_EXIT_ON_FAILURE = commonVars.getTrivyExitOnFailure()
                    env.TRIVY_REPORT_FORMAT = commonVars.getTrivyReportFormat()
                    
                    commonFunctions.printDeploymentInfo(env.TARGET_ENVIRONMENT, env.IMAGE_TAG, env.K8S_NAMESPACE)
                    
                    def services = commonVars.getServicesList()
                    env.CHANGED_SERVICES = commonFunctions.detectChangedServices(services)
                }
                stash name: 'workspace', includes: '**/*'
            }
        }
        
        stage('Build & Test') {
            steps {
                script {
                    def commonVars = load 'jenkins/shared-lib/vars/commonVars.groovy'
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    
                    echo "Building changed services: ${env.CHANGED_SERVICES}"
                    commonFunctions.buildServicesInParallel(
                        env.CHANGED_SERVICES, 
                        env.REGISTRY, 
                        env.IMAGE_TAG, 
                        env.LATEST_TAG
                    )
                }
            }
        }

        stage('Publish to Registry') {
            steps {
                unstash 'workspace'
                withCredentials([usernamePassword(
                    credentialsId: "${DOCKERHUB}", 
                    usernameVariable: 'DOCKER_USER', 
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        commonFunctions.pushDockerImages(
                            env.REGISTRY,
                            env.IMAGE_TAG,
                            env.LATEST_TAG,
                            env.CHANGED_SERVICES,
                            env.DOCKER_USER,
                            env.DOCKER_PASS
                        )
                    }
                }
            }
        }

        stage('Provision Infrastructure (Terraform)') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    echo "Provisioning staging infrastructure via Terraform..."
                    withCredentials([
                        string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                        string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                        string(credentialsId: 'ARM_SUBSCRIPTION_ID', variable: 'ARM_SUBSCRIPTION_ID'),
                        string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                    ]) {
                        sh '''
                            set -e
                            cd infra/terraform/environments/staging
                            terraform version
                            terraform init -input=false
                            
                            # Aplicar Terraform (puede fallar en Grafana por versión, pero creará otros recursos)
                            terraform apply -input=false -auto-approve -var-file=staging.tfvars || true
                            
                            # Si Grafana falló, crearlo manualmente con Azure CLI
                            RG_NAME=$(terraform output -raw resource_group_name)
                            AKS_NAME=$(terraform output -raw aks_cluster_name)
                            GRAFANA_NAME=$(terraform output -raw grafana_name 2>/dev/null || echo "ecom-stg-grafana")
                            PROMETHEUS_WS_ID=$(terraform output -raw prometheus_workspace_id 2>/dev/null || echo "")
                            
                            # Verificar si Grafana existe, si no, crearlo
                            if ! az grafana show --name "$GRAFANA_NAME" --resource-group "$RG_NAME" &>/dev/null; then
                                echo "Creating Grafana manually with Azure CLI (workaround for version 11 requirement)..."
                                chmod +x "${WORKSPACE}/jenkins/scripts/setup-grafana-manual.sh"
                                "${WORKSPACE}/jenkins/scripts/setup-grafana-manual.sh" \
                                    "$RG_NAME" \
                                    "$GRAFANA_NAME" \
                                    "$(terraform output -raw location 2>/dev/null || echo 'eastus2')" \
                                    "$(grep grafana_sku staging.tfvars | cut -d= -f2 | tr -d ' \"' || echo 'Essential')" \
                                    "$PROMETHEUS_WS_ID"
                                
                                # Importar Grafana a Terraform
                                echo "Importing Grafana to Terraform state..."
                                SUBSCRIPTION_ID=$(az account show --query id -o tsv)
                                terraform import \
                                    -var-file=staging.tfvars \
                                    module.monitoring.azurerm_dashboard_grafana.grafana \
                                    "/subscriptions/${SUBSCRIPTION_ID}/resourceGroups/${RG_NAME}/providers/Microsoft.Dashboard/grafana/${GRAFANA_NAME}" || echo "Import may have failed, but Grafana is created"
                            fi
                            
                            # Aplicar nuevamente para sincronizar el estado
                            terraform apply -input=false -auto-approve -var-file=staging.tfvars
                            
                            mkdir -p "${WORKSPACE}/.kube"
                            rm -f "${WORKSPACE}/.kube/${TARGET_ENVIRONMENT}-config"
                            az login --service-principal -u "$ARM_CLIENT_ID" -p "$ARM_CLIENT_SECRET" --tenant "$ARM_TENANT_ID" >/dev/null
                            az aks get-credentials --resource-group "$RG_NAME" --name "$AKS_NAME" --file "${WORKSPACE}/.kube/${TARGET_ENVIRONMENT}-config" --overwrite-existing
                        '''
                    }
                    env.KUBE_CONFIG_PATH = "${env.WORKSPACE}/.kube/${env.TARGET_ENVIRONMENT}-config"
                    env.TF_STAGING_APPLIED = 'true'
                    stash name: 'kubeconfig', includes: ".kube/${env.TARGET_ENVIRONMENT}-config"
                }
            }
        }

        stage('Get Monitoring Endpoints') {
            steps {
                unstash 'workspace'
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    echo "Retrieving monitoring endpoints from Terraform outputs..."
                    def monitoringOutputs = commonFunctions.getMonitoringOutputs(env.K8S_NAMESPACE)
                    def outputFile = commonFunctions.saveMonitoringOutputs(env.K8S_NAMESPACE, monitoringOutputs)
                    stash name: 'monitoring-outputs', includes: ".monitoring-${env.K8S_NAMESPACE}.env"
                    env.PROMETHEUS_INGESTION_ENDPOINT = monitoringOutputs.prometheusIngestionEndpoint
                    env.PROMETHEUS_QUERY_ENDPOINT = monitoringOutputs.prometheusQueryEndpoint
                    env.GRAFANA_ENDPOINT = monitoringOutputs.grafanaEndpoint
                }
            }
        }

        stage('Deploy Prometheus Agent') {
            steps {
                unstash 'workspace'
                unstash 'kubeconfig'
                unstash 'monitoring-outputs'
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        def monitoringOutputs = commonFunctions.loadMonitoringOutputs(env.K8S_NAMESPACE)
                        withCredentials([
                            string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                            string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                            string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                        ]) {
                            commonFunctions.deployPrometheusAgent(
                                env.K8S_NAMESPACE,
                                env.TARGET_ENVIRONMENT,
                                monitoringOutputs.prometheusIngestionEndpoint,
                                env.ARM_CLIENT_ID,
                                env.ARM_TENANT_ID,
                                env.ARM_CLIENT_SECRET
                            )
                        }
                    }
                }
            }
        }
        
        stage('Migrate Grafana Dashboards') {
            steps {
                unstash 'workspace'
                unstash 'monitoring-outputs'
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    def monitoringOutputs = commonFunctions.loadMonitoringOutputs(env.K8S_NAMESPACE)
                    
                    // Intentar obtener API key de credenciales o generarla automáticamente
                    def grafanaApiKey = null
                    
                    // Primero intentar desde credenciales de Jenkins
                    try {
                        withCredentials([
                            string(credentialsId: 'GRAFANA_API_KEY', variable: 'GRAFANA_API_KEY')
                        ]) {
                            grafanaApiKey = env.GRAFANA_API_KEY
                            echo "✓ Using GRAFANA_API_KEY from Jenkins credentials"
                        }
                    } catch (Exception e) {
                        echo "⚠ GRAFANA_API_KEY credential not found, attempting to generate automatically..."
                        
                        // Generar API key automáticamente
                        withCredentials([
                            string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                            string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                            string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID'),
                            string(credentialsId: 'ARM_SUBSCRIPTION_ID', variable: 'ARM_SUBSCRIPTION_ID')
                        ]) {
                            sh '''
                                az login --service-principal -u "$ARM_CLIENT_ID" -p "$ARM_CLIENT_SECRET" --tenant "$ARM_TENANT_ID" >/dev/null
                                az account set --subscription "$ARM_SUBSCRIPTION_ID" >/dev/null
                            '''
                            
                            // Obtener grafana name desde los outputs de monitoring (ya disponibles)
                            def grafanaName = monitoringOutputs.grafanaName
                            
                            // Si no está disponible, usar valor por defecto
                            if (!grafanaName || grafanaName.isEmpty()) {
                                grafanaName = "ecom-${env.K8S_NAMESPACE == 'staging' ? 'stg' : env.K8S_NAMESPACE}-grafana"
                                echo "⚠ Grafana name not found in outputs, using default: ${grafanaName}"
                            }
                            
                            // El resource group sigue el patrón: ecommerce-{namespace}-rg
                            def resourceGroup = "ecommerce-${env.K8S_NAMESPACE}-rg"
                            
                            echo "Attempting to generate API key for:"
                            echo "  Resource Group: ${resourceGroup}"
                            echo "  Grafana Name: ${grafanaName}"
                            
                            // Verificar que el Grafana existe antes de generar la API key
                            def grafanaExists = sh(
                                script: "az grafana show --name '${grafanaName}' --resource-group '${resourceGroup}' --query 'name' -o tsv 2>/dev/null || echo ''",
                                returnStdout: true
                            ).trim()
                            
                            if (!grafanaExists) {
                                echo "⚠ Warning: Grafana '${grafanaName}' not found in resource group '${resourceGroup}'"
                                echo "  Attempting to find Grafana by endpoint..."
                                
                                // Intentar encontrar el Grafana por endpoint
                                def grafanaEndpoint = monitoringOutputs.grafanaEndpoint
                                def foundGrafana = sh(
                                    script: """
                                        GRAFANA_ENDPOINT="${grafanaEndpoint}"
                                        GRAFANA_DOMAIN=\$(echo "\$GRAFANA_ENDPOINT" | sed 's|https://||' | sed 's|http://||' | sed 's|/.*||')
                                        az grafana list --query "[?contains(properties.endpoint, '\${GRAFANA_DOMAIN}')].{name:name, resourceGroup:resourceGroup}" -o json 2>/dev/null | head -5
                                    """,
                                    returnStdout: true
                                ).trim()
                                
                                if (foundGrafana && foundGrafana.contains('"name"')) {
                                    try {
                                        def grafanaList = readJSON text: foundGrafana
                                        if (grafanaList && grafanaList.size() > 0) {
                                            grafanaName = grafanaList[0].name
                                            resourceGroup = grafanaList[0].resourceGroup
                                            echo "✓ Found Grafana: ${grafanaName} in ${resourceGroup}"
                                        }
                                    } catch (Exception parseError) {
                                        echo "Warning: Could not parse Grafana list, using defaults"
                                    }
                                }
                            }
                            
                            grafanaApiKey = commonFunctions.generateGrafanaApiKey(resourceGroup, grafanaName, 'jenkins-migration')
                            
                            // Debug: verificar que la API key sea válida
                            if (grafanaApiKey) {
                                echo "Debug: API key obtained, length: ${grafanaApiKey.length()}"
                                echo "Debug: API key preview: ${grafanaApiKey.take(10)}..."
                            } else {
                                echo "Debug: API key is null or empty"
                            }
                        }
                    }
                    
                    // Migrar dashboards si tenemos API key
                    if (grafanaApiKey && grafanaApiKey.length() >= 20) {
                        echo "Migrating Grafana dashboards to Azure Managed Grafana..."
                        commonFunctions.migrateGrafanaDashboards(
                            monitoringOutputs.grafanaEndpoint,
                            grafanaApiKey,
                            monitoringOutputs.prometheusQueryEndpoint,
                            'k8s/monitoring/grafana-dashboards'
                        )
                    } else {
                        echo "⚠ Warning: Could not obtain valid Grafana API key. Skipping dashboard migration."
                        if (grafanaApiKey) {
                            echo "API key value (invalid): ${grafanaApiKey.take(50)}..."
                        }
                        echo "You can manually migrate dashboards later or configure the GRAFANA_API_KEY credential in Jenkins"
                    }
                }
            }
        }

        stage('Get Logging Endpoints') {
            steps {
                unstash 'workspace'
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    echo "Retrieving logging endpoints from Terraform outputs..."
                    def loggingOutputs = commonFunctions.getLoggingOutputs(env.K8S_NAMESPACE)
                    def outputFile = commonFunctions.saveLoggingOutputs(env.K8S_NAMESPACE, loggingOutputs)
                    stash name: 'logging-outputs', includes: ".logging-${env.K8S_NAMESPACE}.env"
                    env.ELASTICSEARCH_ENDPOINT = loggingOutputs.elasticsearchEndpoint
                    env.ELASTICSEARCH_INTERNAL_ENDPOINT = loggingOutputs.elasticsearchInternalEndpoint
                    env.KIBANA_ENDPOINT = loggingOutputs.kibanaEndpoint
                    env.LOGSTASH_ENDPOINT = loggingOutputs.logstashEndpoint
                }
            }
        }

        stage('Deploy Filebeat') {
            steps {
                unstash 'workspace'
                unstash 'kubeconfig'
                unstash 'logging-outputs'
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        def loggingOutputs = commonFunctions.loadLoggingOutputs(env.K8S_NAMESPACE)
                        echo "Deploying Filebeat to send logs to Elasticsearch in Azure Container Apps..."
                        echo "Elasticsearch Endpoint: ${loggingOutputs.elasticsearchInternalEndpoint}"
                        commonFunctions.deployFilebeat(
                            env.K8S_NAMESPACE,
                            env.TARGET_ENVIRONMENT,
                            loggingOutputs.logAnalyticsWorkspaceId,
                            loggingOutputs.logAnalyticsCustomerId,
                            loggingOutputs.logAnalyticsSharedKey
                        )
                    }
                }
            }
        }
        
        stage('Deploy to Staging') {
            steps {
                unstash 'workspace'
                unstash 'kubeconfig'
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "Deploying to staging environment..."
                        commonFunctions.deployToKubernetes(
                            env.TARGET_ENVIRONMENT,
                            env.K8S_NAMESPACE,
                            env.REGISTRY,
                            env.IMAGE_TAG,
                            env.CHANGED_SERVICES
                        )
                    }
                }
            }
        }

        stage('Run Tests') {
            steps {
                withEnv(["KCFG=${env.KUBE_CONFIG_PATH}"]) {
                    script {
                        def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                        echo "Running all test suites..."
                        env.API_GATEWAY_URL = commonFunctions.getLoadBalancerIP('api-gateway', 'staging')

                        echo "API Gateway URL: ${env.API_GATEWAY_URL}"

                        commonFunctions.runAllTests(env.K8S_NAMESPACE, env.CHANGED_SERVICES)
                    }
                }
            }
        }
        
        stage('Publish Test Coverage Reports') {
            steps {
                script {
                    def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                    commonFunctions.publishPythonCoverageReports()
                    commonFunctions.generateConsolidatedCoverageReport(env.CHANGED_SERVICES)
                }
            }
        }
    }
    
    post {
        success {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                commonFunctions.notifySuccess(env.TARGET_ENVIRONMENT, env.CHANGED_SERVICES)
                echo "All tests passed - ready for production!"
            }
        }
        failure {
            script {
                def commonFunctions = load 'jenkins/shared-lib/vars/commonFunctions.groovy'
                def servicesToRollback = env.SUCCESSFUL_DEPLOYS
                if (servicesToRollback?.trim()) {
                    commonFunctions.rollbackServices(env.K8S_NAMESPACE, servicesToRollback, env.KUBE_CONFIG_PATH)
                } else {
                    echo "Skipping rollback: staging deployment did not run in this execution."
                }
                commonFunctions.notifyFailure(env.TARGET_ENVIRONMENT, servicesToRollback)
                echo "Consider rolling back staging deployment"
            }
        }
        always {
            script {
                if (env.TF_STAGING_APPLIED == 'true') {
                    echo "Destroying staging infrastructure via Terraform..."
                    try {
                        withCredentials([
                            string(credentialsId: 'ARM_CLIENT_ID', variable: 'ARM_CLIENT_ID'),
                            string(credentialsId: 'ARM_CLIENT_SECRET', variable: 'ARM_CLIENT_SECRET'),
                            string(credentialsId: 'ARM_SUBSCRIPTION_ID', variable: 'ARM_SUBSCRIPTION_ID'),
                            string(credentialsId: 'ARM_TENANT_ID', variable: 'ARM_TENANT_ID')
                        ]) {
                            sh '''
                                set +e
                                cd infra/terraform/environments/staging
                                terraform destroy -input=false -auto-approve -var-file=staging.tfvars
                            '''
                        }
                    } catch (err) {
                        echo "Terraform destroy failed: ${err}"
                    }
                } else {
                    echo "Skipping Terraform destroy (infrastructure was not provisioned by this run)."
                }
            }
        }
        cleanup {
            cleanWs()
        }
    }
}